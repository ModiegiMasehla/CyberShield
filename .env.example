DATABASE_URL=postgresql+psycopg://cybershield:cybershield@postgres:5432/cybershield
SECRET_KEY=change-this-development-secret-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=60
SEED_DEMO_DATA=true
# Set AUTO_CREATE_SCHEMA=false to manage the schema with Alembic only
AUTO_CREATE_SCHEMA=true
LOGIN_RATE_LIMIT_PER_MINUTE=10
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
